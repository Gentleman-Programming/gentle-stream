#!/usr/bin/env python3
"""Run the current device's Windows Gentle Shell bundle from WSL."""
import os
from pathlib import Path
import re
import subprocess
import sys


BUNDLE_ENV = "GENTLE_STREAM_WINDOWS_SHELL_BUNDLE"
WSLPATH = "/usr/bin/wslpath"


def discover_bundle() -> Path:
    """Look only inside the active Windows profile, never across user directories."""
    configured = os.environ.get(BUNDLE_ENV)
    if configured:
        path = Path(configured)
        if not path.is_absolute():
            raise ValueError(f"{BUNDLE_ENV} must be an absolute WSL path")
        return path
    try:
        # /u writes UTF-16LE, avoiding the active Windows codepage for user names.
        # A constant `set` command prints the value without expanding it as
        # CMD source; profile names containing `&` cannot become commands.
        result = subprocess.run(
            ["cmd.exe", "/u", "/d", "/c", "set USERPROFILE"],
            stdin=subprocess.DEVNULL, capture_output=True, check=True, timeout=5,
        )
        records = (line.partition("=") for line in result.stdout.decode("utf-16-le").splitlines())
        profiles = [value for name, separator, value in records
                    if separator and name.upper() == "USERPROFILE"]
        if len(profiles) != 1:
            raise ValueError("missing or duplicate Windows profile")
        profile = profiles[0]
        if not re.fullmatch(r"[A-Za-z]:\\[^\r\n\x00]+", profile):
            raise ValueError("invalid Windows profile")
        result = subprocess.run(
            [WSLPATH, "-u", profile], stdin=subprocess.DEVNULL,
            capture_output=True, text=True, check=True, timeout=5,
        )
        path = result.stdout.strip()
        if not path.startswith("/") or "\n" in path or "\r" in path:
            raise ValueError("invalid WSL profile path")
        return Path(path) / ".gentle-shell-bundle"
    except (OSError, UnicodeError, ValueError, subprocess.SubprocessError) as error:
        raise ValueError(f"Windows profile discovery unavailable; set {BUNDLE_ENV}") from error


def _inside_bundle(path: Path, bundle: Path) -> Path:
    """Reject a forged version/runtime symlink before executing any Windows code."""
    resolved = path.resolve(strict=True)
    if not resolved.is_relative_to(bundle):
        raise ValueError("bundle path escapes configured root")
    return resolved


def to_windows(path: Path) -> str:
    result = subprocess.run(
        [WSLPATH, "-w", str(path)], stdin=subprocess.DEVNULL,
        capture_output=True, text=True, check=True, timeout=5,
    )
    converted = result.stdout.strip()
    if not converted or "\n" in converted or "\r" in converted:
        raise ValueError("invalid Windows entrypoint path")
    return converted


def main(args):
    try:
        bundle = discover_bundle().resolve(strict=True)
        version = _inside_bundle(bundle / "current", bundle).read_text(encoding="utf-8").strip()
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", version):
            raise ValueError("invalid bundle version in current")
        relative = Path("versions") / version / "node_modules/gentle-pi/bin/gentle-shell.mjs"
        entrypoint = bundle / relative
        if not entrypoint.is_file():
            raise ValueError("Gentle Shell entrypoint not found in bundle")
        entrypoint = _inside_bundle(entrypoint, bundle)
        nodes = list(bundle.glob("runtime/node-*/node.exe"))
        if not nodes:
            raise ValueError("Windows Node not found in bundle runtime")
        if len(nodes) != 1:
            raise ValueError("ambiguous bundled Windows Node runtimes")
        node = _inside_bundle(nodes[0], bundle)
        if not node.is_file():
            raise ValueError("Windows Node not found in bundle runtime")
        # Windows Node needs a Windows script path. Arguments and streams pass
        # through execv unchanged, without a shell or npm wrapper.
        os.execv(str(node), [str(node), to_windows(entrypoint), *args])
    except (OSError, UnicodeError, ValueError, subprocess.SubprocessError) as error:
        print(f"gentle-shell-windows: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
